# Public site URL used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://tranzitgroup.com.au

# Optional: an HTTPS endpoint that accepts a JSON POST with the contact form payload
# (e.g. a Formspree/Make/Zapier webhook or your own API). If unset, the contact form
# explains that submissions are not configured and offers email instead.
CONTACT_WEBHOOK_URL=
